#include <windows.h>

1 ICON "capture.ico"
1 24 "grabber.manifest"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Benoit Saint-Moulin"
      VALUE "FileDescription", "Grabber, a small screen recorder"
      VALUE "FileVersion", "1.2.0"
      VALUE "InternalName", "Grabber"
      VALUE "LegalCopyright", "Copyright 2026 Benoit Saint-Moulin"
      VALUE "OriginalFilename", "Grabber.exe"
      VALUE "ProductName", "Grabber"
      VALUE "ProductVersion", "1.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
